{
  "name": "locus-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/version.mjs && tsc -b tsconfig.json",
    "bundle": "pnpm build && node scripts/bundle.mjs",
    "test": "node --test packages/core/test/*.test.mjs components/remote-targets/test/*.test.mjs components/templates/test/*.test.mjs apps/cli/test/*.test.mjs tests/*.test.mjs",
    "test:all": "node tests/run.mjs all",
    "e2e": "node tests/run.mjs e2e",
    "test:file": "node --test",
    "format": "prettier --write \"apps/*/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"components/*/src/**/*.ts\" \"eslint.config.mjs\"",
    "format:check": "prettier --check \"apps/*/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"components/*/src/**/*.ts\" \"eslint.config.mjs\"",
    "lint": "eslint \"apps/*/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"components/*/src/**/*.ts\"",
    "verify": "pnpm build && pnpm lint && pnpm format:check && pnpm test && pnpm docs:check",
    "verify:full": "pnpm build && pnpm lint && pnpm format:check && pnpm test:all && pnpm docs:check && pnpm e2e",
    "locus": "node apps/cli/lib/index.js",
    "locus:register": "node scripts/local.mjs register",
    "locus:unregister": "node scripts/local.mjs unregister",
    "locus:purge": "node scripts/local.mjs purge",
    "locus:backup": "node scripts/backup.mjs",
    "docs:check": "node scripts/docs.mjs",
    "docs:test": "node --test scripts/docs.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.73.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
