{
  "name": "@locus/core",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invocation": {
      "types": "./lib/invocation/index.d.ts",
      "default": "./lib/invocation/index.js"
    },
    "./components": {
      "types": "./lib/components/index.d.ts",
      "default": "./lib/components/index.js"
    },
    "./security": {
      "types": "./lib/security/index.d.ts",
      "default": "./lib/security/index.js"
    },
    "./workspaces": {
      "types": "./lib/workspaces/index.d.ts",
      "default": "./lib/workspaces/index.js"
    },
    "./events": {
      "types": "./lib/events/index.d.ts",
      "default": "./lib/events/index.js"
    },
    "./i18n": {
      "types": "./lib/i18n/index.d.ts",
      "default": "./lib/i18n/index.js"
    },
    "./storage": {
      "types": "./lib/storage/index.d.ts",
      "default": "./lib/storage/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node ../../scripts/version.mjs && tsc -b tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "execa": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
