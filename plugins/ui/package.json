{
  "name": "@locus/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "web"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && tsc -p web/tsconfig.json --noEmit && vite build",
    "build:web": "tsc -p web/tsconfig.json --noEmit && vite build",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@locus/application": "workspace:*",
    "@locus/contracts": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5"
  }
}
